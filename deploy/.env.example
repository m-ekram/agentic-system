# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored
# (the root .gitignore's ".env" matches at any depth) and dockerignored.

# The bearer token clients must send. At least 32 characters, or the server
# refuses to start. Generate one with:  openssl rand -hex 32
MCP_TOKEN=

# The public hostname, e.g. a free DuckDNS name pointing at your Elastic IP.
# Caddy requests its certificate for this name, and the server rejects requests
# addressed to any other host.
MCP_PUBLIC_HOST=yourname.duckdns.org
