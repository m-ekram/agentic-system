# Copy this file to .env and fill in your key. .env is gitignored.
#
# The agent talks to any OpenAI-compatible endpoint, so switching providers is
# these three lines — never a code change.

# --- Default: Google Gemini free tier -------------------------------------
# Free key, no card required: https://aistudio.google.com/apikey
# Check the current model list there; model names change.
API_KEY=paste-your-gemini-key-here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.6-flash

# --- Backup: Groq free tier (fast, separate quota) ------------------------
# Free key: https://console.groq.com/keys
# API_KEY=paste-your-groq-key-here
# BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# --- Fully offline: Ollama (no key, no limits, slower) --------------------
# Install from https://ollama.com, then: ollama pull qwen2.5:7b
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:7b
